{
  "version": "2.0.0",
  "tasks": [
    {"label": "Check", "type": "shell", "command": "uv run ruff check . && uv run ruff format --check . && uv run pytest", "group": "build"},
    {"label": "Test", "type": "shell", "command": "uv run pytest", "group": "test"},
    {"label": "Lint", "type": "shell", "command": "uv run ruff check ."},
    {"label": "Format", "type": "shell", "command": "uv run ruff format ."},
    {"label": "FastAPI Dev", "type": "shell", "command": "uv run uvicorn podr.app:app --app-dir src --reload", "isBackground": true},
    {"label": "Worker Dev", "type": "shell", "command": "uv run pywrangler dev", "isBackground": true},
    {"label": "Build", "type": "shell", "command": "uv run pywrangler deploy --dry-run --outdir=dist --containers-rollout=none", "group": "build"},
    {"label": "Build Container", "type": "shell", "command": "docker build -t podr-proxy:dev ."}
  ]
}
