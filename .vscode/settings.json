{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["src"],
  // ty finds the project environment through uv (experimental; needs uv
  // 0.12.3+ and a trusted workspace). The extension turns off Pylance.
  "ty.experimental.useUv": "on",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "files.exclude": {
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.venv": true,
    "**/.venv-workers": true,
    "**/__pycache__": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/python_modules": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/.venv-workers": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/python_modules": true
  }
}
