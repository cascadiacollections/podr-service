{
  "name": "Podr Python Service",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "containerEnv": {
    "PYTHONUNBUFFERED": "1",
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
    "source=podr-uv-cache,target=/home/vscode/.cache/uv,type=volume",
    "source=podr-node-cache,target=/home/vscode/.npm,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "cloudflare.cloudflare-workers-bindings-extension",
        "EditorConfig.EditorConfig",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "ms-python.python"
      ]
    }
  },
  "onCreateCommand": "sudo mkdir -p /home/vscode/.cache/uv /home/vscode/.npm && sudo chown -R vscode:vscode /home/vscode/.cache/uv /home/vscode/.npm",
  "updateContentCommand": "uv sync --frozen",
  "postCreateCommand": "uv run python --version && uv run pywrangler --version",
  "waitFor": "updateContentCommand",
  "forwardPorts": [8787, 8000],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    },
    "8787": {
      "label": "Cloudflare Worker",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "vscode"
}
